# ====================================================================
# Git Ignore Configuration for Easy Tunnel
# ====================================================================

# OS generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configurations
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/

# Flutter build artifacts
app/build/
**/doc/api/
/coverage/

# Windows C++ / CMake build artifacts
*.obj
*.pdb
*.ilk
*.idb
*.tlog
*.exp
*.lib
CMakeSettings.json
CMakeCache.txt
CMakeFiles/
Win32/
x64/
[Dd]ebug/
[Rr]elease/

# Packaged binaries and installers
# (Distributables should be hosted on GitHub Releases, not git repository)
dist/*.exe
dist/*.zip
!dist/.gitkeep

# Sensitive local runtime data & tokens
**/config.json
*usage_history.json
*.token
*.local.json

# Temporary / Log files
*.log
*.tmp
*.bak
findings.md
progress.md
task_plan.md
